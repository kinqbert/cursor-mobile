{
  "expo": {
    "name": "Cursor Mobile",
    "slug": "cursor-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cursormobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F8F6",
    "android": {
      "package": "com.kinqbert.cursormobile",
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 72,
          "dark": {
            "backgroundColor": "#0E0E0E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for voice prompts.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to transcribe voice prompts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos to prompts.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to attach photos to prompts."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1C1C1B",
          "defaultChannel": "agents"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8619cc9a-ce82-48b0-8471-5c1136159aa7"
      }
    },
    "owner": "kinqbert"
  }
}
